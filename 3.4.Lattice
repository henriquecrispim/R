```{r}
#este pacote não precisa instalar! Somente carregar, ele já vem instalado por padrão
library(lattice)
```
Boxplot
```{r}
bwplot(trees$Volume)
bwplot(trees$Volume, main="Árvores",xlab="Volume")
```
Histograma
Aspecto é a proporção, nint número de quebras, type: percent, count, density
```{r}
histogram(trees$Volume, main="Árvores",xlab="Volume",aspect=1, type = "percent", nint=5 )
```
Histograma condicional
```{r}
#Peso das galinhas de acordo com alimentação
chickwts
#histrograma
histogram(chickwts$weight)
#agregamos dados
aggregate(chickwts$weight, by=list(chickwts$feed), FUN=sum) #soma o peso pela forma de alimentação # a tabela apresenta o tipo de alimentação e o peso total
#histograma condicional
histogram( ~weight | feed, data=chickwts) #peso condicional à alimentação do conjunto de dados chickwts #como se comportou os dados de acordo com o tipo de alimentação
```
Gráfico de dispersão condicional
CO2, seis plantas em dois locais, refrigeradas ou não durante a noite
```{r}
#CO2, conc: concentração de co2, uptake: captação de co2
CO2
xyplot(CO2$conc ~  CO2$uptake)
#type é a origem 
xyplot(CO2$conc ~  CO2$uptake | CO2$Type) #concentração de co2 e captação de co2 condicionadas ao Type (origem)
#regrigerado ou não
xyplot(CO2$conc ~  CO2$uptake | CO2$Treatment) #concentração de co2 e captação de co2 condicionadas ao Treatment (regrigeradas ou não)
```
Cancer de esofago
agegp: idade, alcgp: alcool, tobgp: tabaco
```{r}
esoph
dotplot(esoph$alcgp ~ esoph$ncontrols, data=esoph)
dotplot(esoph$alcgp ~ esoph$ncontrols | esoph$tobgp)
```
Matriz de dispersão
```{r}
splom(~CO2[4:5] | CO2$Type, CO2)
```
Densidade condicional
```{r}
densityplot(~CO2$conc | CO2$Treatment, plot.points=FALSE)
densityplot(CO2$conc)
densityplot(~CO2$conc | CO2$Treatment)
densityplot(~CO2$conc | CO2$Treatment, plot.points=FALSE) #plot.points=FALSE -> elimina os pontos de plotagem
```
Gráfico 3D
Spray para repelir abelhas
```{r}
OrchardSprays
cloud(decrease ~  rowpos * colpos, data=OrchardSprays) #3 variáveis -> tridimensional
cloud(decrease ~  rowpos * colpos, groups=treatment, data=OrchardSprays) #groups=treatment -> pontos coloridos de acordo com o tipo de spray utilizado 
```
Level plot
Circunferência, largura e volume de árvores
```{r}
trees
levelplot(Girth ~ Height * Volume, data=trees) #a cor é a circunferência, quanto maior, mais tende a ir para o azul 
```
