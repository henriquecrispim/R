Valore faltantes - NAs
```{r}
#valores faltantes NAs # ! -> significa "not"
dados[!complete.cases(dados),]  #mostra todas as linhas que estão incompletas
```
Salários
```{r}
#tratar salários
summary(dados$Salario)
#ver mediana
median(dados$Salario,na.rm = T) #na.rm = T -> para removar valores vazios
#atribuir mediana a NAs (substitui os valores vazios pela medianan)
dados[is.na(dados$Salario),]$Salario = median(dados$Salario,na.rm = T)
#buscar NAS em salario para checar
dados[!complete.cases(dados$Salario),] # o valor é zero pois as NAs foram substituidas
```
Falta de padronização em Gênero
```{r}
#Ver valores
unique(dados$Genero)
summary(dados$Genero)
#tranformar F e Fem em Feminino
# "" , M em Masculino (moda)
dados[is.na(dados$Genero) | dados$Genero == "M" ,]$Genero = "Masculino"  #transforma valores vazios e "M" em Masculino
dados[dados$Genero == "F" | dados$Genero == "Fem", ]$Genero = "Feminino" #transforma valores "F" e "Fem" em Feminino
#ver resultado
summary(dados$Genero)
#remover levels não utilizados 
dados$Genero =   factor(dados$Genero)
#visualizar novamente
summary(dados$Genero)
```
Idades fora do domínio
```{r}
summary(dados$Idade)
#fora do dominio, numérico - ver idades anormais #Filtrando idades anormais (negativas ou maiores que 110)
dados[dados$Idade<0 | dados$Idade>110 ,]$Idade
#não temos idade NAs
dados[is.na(dados$Idade),]
#opção, preencher com mediana
median(dados$Idade)
#subtituição
dados[dados$Idade<0 | dados$Idade>110 ,]$Idade = median(dados$Idade)  #substitui as idades anormais pela mediana
#buscamos novamente idades anormais
dados[dados$Idade<0 | dados$Idade>110 ,]
summary(dados$Idade)
```
Dados duplicados
```{r}
#buscar duplicados pelo ID
x =  dados[duplicated(dados$Id),] #registro duplicado
x
#verificamos que o ID 81 está duplicado
#vamos excluir pelo indice 82
dados = dados[-c(82),]

#buscamos a linha que estava duplicada
dados[dados$Id == x$Id ,]
#verificamos novamente duplicados
x =  dados[duplicated(dados$Id),]
x
```
Estado fora do domínio
```{r}
#fora do dominio - categorico
unique(dados$Estado)
summary(dados$Estado)
#preencher com a moda, RS
dados[!dados$Estado %in% c("RS","SC","PR"),]$Estado = "RS"
summary(dados$Estado)
#removemos fatores não usados
dados$Estado =   factor(dados$Estado)
#visualizar novamente
summary(dados$Estado)
```
Outliers (valores fora do padrão)
```{r}
#outliers, criando um parametro com desvio padrão
desv = sd(dados$Salario, na.rm = T)
desv
dados[dados$Salario >= 2 *desv, ]$Salario
#outra forma, resultado semelhante, mas sem os NAs
boxplot(dados$Salario) #com outliers
boxplot(dados$Salario, outline = F) #sem outliers
x = boxplot(dados$Salario)$out #ver os valores dos outliers
x
#atualizamos todos para mediana
median(dados$Salario)
dados[dados$Salario >= 2 *desv  , ]$Salario = median(dados$Salario) #todos os valores maiores ou iguais a 2 *desv será substituído pela mediana dos salários
#checamos se sairam os outliers
dados[dados$Salario >= 2 *desv  , ]$Salario #não tem mais outliers pelo fato de terem sido substituídos pela mediana dos salários
```


