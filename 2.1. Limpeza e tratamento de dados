Aparência, tratar dominio
```{r}
summary(dados$Aparencia)  
#não temos NAs
dados[is.na(dados$Aparencia),] #para saber se tem valores faltantes na Aparência
#opção, preencher com mediana
#subtituição com moda
dados[dados$Aparencia == 'menos' ,]$Aparencia = 'sol' #subtitui o "menos" pelo "sol"
#buscamos novamente aparencias
summary(dados$Aparencia)
#remover levels não utilizados 
dados$Aparencia =   factor(dados$Aparencia) #remover o level "menos" que não esta sendo utilizado 
#visualizar novamente
summary(dados$Aparencia)  # o level "menos" saiu do summary
```
Temperatura - tratar dominio
```{r}
summary(dados$Temperatura)
#fora do dominio, numérico - ver temperaturas anormais
dados[dados$Temperatura < -130 | dados$Temperatura > 130 ,]$Temperatura
#não temos NAs
dados[is.na(dados$Temperatura),] #para saber se tem valores faltantes na Temperatura
#opção, preencher com mediana
median(dados$Temperatura)
#subtituição
dados[dados$Temperatura < -135 | dados$Temperatura > 130 ,]$Temperatura = median(dados$Temperatura) #subtitui as temperaturas anormais (menores que -135 e maiores que 130) pela mediana
#buscamos novamente temperaturas anormais
dados[dados$Temperatura< -135 | dados$Temperatura > 130 ,]$Temperatura
summary(dados$Temperatura)
```
Umidade, dominio e NAs
```{r}
summary(dados$Umidade)
#fora do dominio, numérico - ver umidades anormais
dados[dados$Umidade < 0 | dados$Umidade > 100 ,]$Umidade
#Verifica NAs
dados[is.na(dados$Umidade),] #para saber se tem valores faltantes na Umidade
#atribuir mediana a NAs
dados[is.na(dados$Umidade),]$Umidade = median(dados$Umidade,na.rm = T) #subtitui os valores faltantes pela mediana
dados[dados$Umidade < 0 | dados$Umidade > 100 ,]$Umidade = median(dados$Umidade) #subtitui as umidades anormais (menores que 0 e maiores que 100) pela mediana
#buscamos novamente umidades anormais
dados[dados$Umidade < 0 | dados$Umidade > 100 ,] #verificando se tem umidade anormal ainda
dados[is.na(dados$Umidade),] #verificando se tem valores faltantes ainda
summary(dados$Umidade)
```
